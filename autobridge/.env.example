# ---------------------------------------------------------------------------
# AutoBridge DZ — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public (exposed to the browser) ------------------------------------------------
# Supabase project URL and publishable (anon) key: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Canonical public URL of the site (used for metadata, sitemap and e-mail links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (NEVER prefix with NEXT_PUBLIC_) -------------------------------------
# Service role key. Used only by the notification e-mail dispatcher and by the
# command-line scripts (seed, create-admin, tests). The web app's user-facing code
# never uses it: every user request runs under the user's own session and RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared secret protecting /api/notifications/dispatch (send as "Authorization: Bearer <secret>").
CRON_SECRET=replace-with-a-long-random-string

# Notification e-mails: "console" (development: logs a redacted summary), "resend", or "disabled".
EMAIL_PROVIDER=disabled
EMAIL_FROM="AutoBridge DZ <no-reply@your-domain.example>"
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Authentication e-mails (sign-up confirmation, password recovery) are sent by
# Supabase Auth, not by this app: configure SMTP in the Supabase dashboard
# (Authentication → Emails → SMTP settings). See README.md.
